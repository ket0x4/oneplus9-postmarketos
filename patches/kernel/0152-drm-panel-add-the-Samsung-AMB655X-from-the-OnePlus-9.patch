From c98cf8f60ef5b00127020c7228914153a90e4bf1 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Wed, 18 Nov 2026 23:19:10 +0300
Subject: [PATCH 152/167] drm/panel: add the Samsung AMB655X from the OnePlus 9

A 1080x2400 DSC command mode AMOLED panel, driven at 60 and 120 Hz. The init
sequence, timings and DSC geometry were read back out of the panel node the
vendor device tree leaves in /sys/firmware/devicetree and replayed with
tools/gen-panel.py, the same way the 9 Pro's panel was done.

The reset line is optional: on boards where the bootloader leaves the panel
running, a reset loses the initialised DSI link.
---
 drivers/gpu/drm/panel/Kconfig                 |  13 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 drivers/gpu/drm/panel/panel-samsung-amb655x.c | 361 ++++++++++++++++++
 3 files changed, 375 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-amb655x.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 2d787668f..534ba61bf 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -920,6 +920,19 @@ config DRM_PANEL_SAMSUNG_S6E88A0_AMS452EF01
 	select DRM_MIPI_DSI
 	select VIDEOMODE_HELPERS
 
+config DRM_PANEL_SAMSUNG_AMB655X
+	tristate "Samsung AMB655X DSI command mode panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	select DRM_DISPLAY_HELPER
+	help
+	  Say Y or M here if you want to enable support for the Samsung
+	  AMB655X 6.55" 1080x2400 DSC command mode AMOLED panel found in the
+	  OnePlus 9. Its reset line is optional: the bootloader may leave the
+	  panel initialised and the DSI link in a state that a reset breaks.
+
 config DRM_PANEL_SAMSUNG_AMB670YF01
 	tristate "Samsung AMB670YF01 DSI command mode panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index d242863eb..3c5d314c7 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -88,6 +88,7 @@ obj-$(CONFIG_DRM_PANEL_RENESAS_R69328) += panel-renesas-r69328.o
 obj-$(CONFIG_DRM_PANEL_RONBO_RB070D30) += panel-ronbo-rb070d30.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_AMS581VF01) += panel-samsung-ams581vf01.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_AMS639RQ08) += panel-samsung-ams639rq08.o
+obj-$(CONFIG_DRM_PANEL_SAMSUNG_AMB655X) += panel-samsung-amb655x.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_AMB670YF01) += panel-samsung-amb670yf01.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_ATNA33XC20) += panel-samsung-atna33xc20.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_DB7430) += panel-samsung-db7430.o
diff --git a/drivers/gpu/drm/panel/panel-samsung-amb655x.c b/drivers/gpu/drm/panel/panel-samsung-amb655x.c
new file mode 100644
index 000000000..e3386de7f
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-amb655x.c
@@ -0,0 +1,361 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung AMB655X 1080x2400 DSC command mode AMOLED panel (OnePlus 9)
+ *
+ * Init sequence read back from the vendor device tree (timing timing@1)
+ * with tools/gen-panel.py.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct amb655x {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+};
+
+static const struct regulator_bulk_data amb655x_supplies[] = {
+	{ .supply = "vddio" },	/* 1.8V */
+	{ .supply = "vdd" },	/* 3.0V */
+	{ .supply = "avdd" },	/* 5.5V */
+};
+
+static inline struct amb655x *to_amb655x(struct drm_panel *panel)
+{
+	return container_of(panel, struct amb655x, panel);
+}
+
+static void amb655x_reset(struct amb655x *ctx)
+{
+	/* vendor qcom,mdss-dsi-reset-sequence: high 10ms, low 1ms, high 10ms */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static void amb655x_send_pps(struct amb655x *ctx,
+			      struct mipi_dsi_multi_context *dsi_ctx)
+{
+	u8 buf[1 + sizeof(struct drm_dsc_picture_parameter_set)];
+
+	buf[0] = 0x9e;
+	drm_dsc_pps_payload_pack((struct drm_dsc_picture_parameter_set *)&buf[1],
+				 &ctx->dsc);
+	mipi_dsi_dcs_write_buffer_multi(dsi_ctx, buf, sizeof(buf));
+}
+
+static int amb655x_on(struct amb655x *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_send_pps(ctx, &dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9d, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_usleep_range(&dsi_ctx, 11000, 12000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x04);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd5, 0x24, 0x9e, 0x9e, 0x00, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x16);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd1, 0x22);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd6, 0x11);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xdf, 0x83, 0x00, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe6, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2a, 0x00, 0x00, 0x04, 0x37);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2b, 0x00, 0x00, 0x09, 0x5f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd5, 0x8d);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x0a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd5, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe4, 0xa6, 0x75, 0xa3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe9, 0x11, 0x75, 0xa6, 0x75, 0xa3, 0x4b, 0x17, 0xac, 0x4b, 0x17, 0xac, 0x00, 0x19, 0x19);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_msleep(&dsi_ctx, 61);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x13);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x4c);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x53, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amb655x_enable(struct drm_panel *panel)
+{
+	struct amb655x *ctx = to_amb655x(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* vendor qcom,mdss-dsi-post-on-backlight */
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amb655x_disable(struct drm_panel *panel)
+{
+	struct amb655x *ctx = to_amb655x(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x28);
+	mipi_dsi_msleep(&dsi_ctx, 21);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x10);
+	mipi_dsi_msleep(&dsi_ctx, 101);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amb655x_prepare(struct drm_panel *panel)
+{
+	struct amb655x *ctx = to_amb655x(panel);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(amb655x_supplies), ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	if (ctx->reset_gpio)
+		amb655x_reset(ctx);
+
+	ret = amb655x_on(ctx);
+	if (ret < 0) {
+		if (ctx->reset_gpio)
+			gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(amb655x_supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int amb655x_unprepare(struct drm_panel *panel)
+{
+	struct amb655x *ctx = to_amb655x(panel);
+
+	if (ctx->reset_gpio)
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(amb655x_supplies), ctx->supplies);
+
+	return 0;
+}
+
+static const struct drm_display_mode amb655x_modes[] = {
+	{
+		.clock = (1080 + 52 + 24 + 24) * (2400 + 4 + 4 + 8) * 120 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1132,
+		.hsync_end = 1156,
+		.htotal = 1180,
+		.vdisplay = 2400,
+		.vsync_start = 2404,
+		.vsync_end = 2408,
+		.vtotal = 2416,
+		.width_mm = 70,
+		.height_mm = 151,
+		.type = DRM_MODE_TYPE_DRIVER,
+	},
+	{
+		.clock = (1080 + 52 + 24 + 24) * (2400 + 1208 + 4 + 8) * 60 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1132,
+		.hsync_end = 1156,
+		.htotal = 1180,
+		.vdisplay = 2400,
+		.vsync_start = 3608,
+		.vsync_end = 3612,
+		.vtotal = 3620,
+		.width_mm = 70,
+		.height_mm = 151,
+		.type = DRM_MODE_TYPE_DRIVER,
+	},
+};
+
+static int amb655x_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(amb655x_modes); i++) {
+		struct drm_display_mode *mode;
+
+		mode = drm_mode_duplicate(connector->dev, &amb655x_modes[i]);
+		if (!mode)
+			return -ENOMEM;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = amb655x_modes[0].width_mm;
+	connector->display_info.height_mm = amb655x_modes[0].height_mm;
+
+	return ARRAY_SIZE(amb655x_modes);
+}
+
+static const struct drm_panel_funcs amb655x_panel_funcs = {
+	.prepare = amb655x_prepare,
+	.unprepare = amb655x_unprepare,
+	.enable = amb655x_enable,
+	.disable = amb655x_disable,
+	.get_modes = amb655x_get_modes,
+};
+
+static int amb655x_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret < 0 ? ret : 0;
+}
+
+static const struct backlight_ops amb655x_bl_ops = {
+	.update_status = amb655x_bl_update_status,
+};
+
+static struct backlight_device *amb655x_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 1023,
+		.max_brightness = 4095,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &amb655x_bl_ops, &props);
+}
+
+static int amb655x_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct amb655x *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct amb655x, panel,
+				   &amb655x_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(amb655x_supplies),
+					    amb655x_supplies, &ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	/* vendor qcom,mdss-dsi-lp11-init */
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = amb655x_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	dsi->dsc = &ctx->dsc;
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 30;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_count = 2;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void amb655x_remove(struct mipi_dsi_device *dsi)
+{
+	struct amb655x *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id amb655x_of_match[] = {
+	{ .compatible = "samsung,amb655x" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, amb655x_of_match);
+
+static struct mipi_dsi_driver amb655x_driver = {
+	.probe = amb655x_probe,
+	.remove = amb655x_remove,
+	.driver = {
+		.name = "panel-samsung-amb655x",
+		.of_match_table = amb655x_of_match,
+	},
+};
+module_mipi_dsi_driver(amb655x_driver);
+
+MODULE_DESCRIPTION("Samsung AMB655X 1080x2400 DSC command mode AMOLED panel (OnePlus 9)");
+MODULE_LICENSE("GPL");
-- 
