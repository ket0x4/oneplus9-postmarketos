From 5d556329d0ae68f00f5b50edb68d0f6c9234ae02 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Thu, 19 Nov 2026 01:53:06 +0300
Subject: [PATCH 155/167] clk: qcom: dispcc-sm8250: don't park the rotator RCG either

The other display RCGs here already use clk_rcg2_shared_no_init_park_ops, but
disp_cc_mdss_rot_clk_src still parks on XO at registration. On sm8350 that cuts
the rotator clock of the display the bootloader is still scanning out, and with
a command mode panel the result is a frozen screen rather than a visible error.

Same reasoning as the rest of the file, as dispcc-sc8280xp does.
---
 drivers/clk/qcom/dispcc-sm8250.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/qcom/dispcc-sm8250.c b/drivers/clk/qcom/dispcc-sm8250.c
index 49c0780fa..29bd3262a 100644
--- a/drivers/clk/qcom/dispcc-sm8250.c
+++ b/drivers/clk/qcom/dispcc-sm8250.c
@@ -616,7 +616,12 @@ static struct clk_rcg2 disp_cc_mdss_rot_clk_src = {
 		.parent_data = disp_cc_parent_data_5,
 		.num_parents = ARRAY_SIZE(disp_cc_parent_data_5),
 		.flags = CLK_SET_RATE_PARENT,
-		.ops = &clk_rcg2_shared_ops,
+		/*
+		 * Parking this RCG on XO at registration cuts the rotator clock
+		 * of the display the bootloader left running, which stalls the
+		 * boot on sm8350. See the other display RCGs here.
+		 */
+		.ops = &clk_rcg2_shared_no_init_park_ops,
 	},
 };
 
