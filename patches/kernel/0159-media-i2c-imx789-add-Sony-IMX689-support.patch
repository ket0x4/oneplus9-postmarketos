From b2ba197324273476d9da6c2ac2e0e9fcb9892c54 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?ibrahim=20y=C3=B6ndemli?= <ket0x4@pm.me>
Date: Fri, 20 Nov 2026 10:16:46 +0300
Subject: [PATCH 159/167] media: i2c: imx789: add Sony IMX689 support

Add init, 4000x3000@30fps and 2000x1128@30fps C-PHY register tables and OF match data for the Sony IMX689 (chip ID 0x0689) used as the main camera on the OnePlus 9 (lemonade), extracted from odm/lib64/camera/com.qti.sensormodule.lemonade.semco_imx689.bin.
---
 drivers/media/i2c/Kconfig  |    7 +-
 drivers/media/i2c/imx789.c | 2509 +++++++++++++++++++++++++++++++++++-
 2 files changed, 2508 insertions(+), 8 deletions(-)

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 9ad072fa2..4c42a0ceb 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -310,12 +310,13 @@ config VIDEO_IMX471
 	  module will be called imx471.
 
 config VIDEO_IMX789
-	tristate "Sony IMX789 and IMX766 sensor support"
+	tristate "Sony IMX689, IMX789 and IMX766 sensor support"
 	depends on GPIOLIB
 	select V4L2_CCI_I2C
 	help
-	  This is a Video4Linux2 sensor driver for the Sony IMX789
-	  (48 MP) and IMX766 (50 MP) cameras, which use MIPI C-PHY.
+	  This is a Video4Linux2 sensor driver for the Sony IMX689
+	  (48 MP), IMX789 (48 MP) and IMX766 (50 MP) cameras, which use
+	  MIPI C-PHY.
 
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx789.
diff --git a/drivers/media/i2c/imx789.c b/drivers/media/i2c/imx789.c
index 40971ef34..36ed2a106 100644
--- a/drivers/media/i2c/imx789.c
+++ b/drivers/media/i2c/imx789.c
@@ -1,10 +1,10 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * Sony IMX789 / IMX766 image sensor driver
+ * Sony IMX689 / IMX789 / IMX766 image sensor driver
  *
- * Register settings come from the OnePlus 9 Pro camera module data
- * (com.qti.sensormodule.lemonadep.{semco_imx789,sunny_imx766}.bin).
- * Both sensors talk MIPI C-PHY over three trios.
+ * Register settings come from the OnePlus 9 / 9 Pro camera module data
+ * (com.qti.sensormodule.{lemonade.semco_imx689,lemonadep.{semco_imx789,sunny_imx766}}.bin).
+ * All three sensors talk MIPI C-PHY over three trios.
  */
 
 #include <linux/clk.h>
@@ -1243,6 +1243,2504 @@ static const struct imx789_chip imx766_chip = {
 	.native_height = 6144,
 };
 
