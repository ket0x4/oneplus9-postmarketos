From f9abbde71f5ef3a33c6c374f29908ade33766728 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Thu, 19 Nov 2026 01:52:42 +0300
Subject: [PATCH 154/167] arm64: dts: qcom: sm8350-oneplus-lemonade: fix USB role and
 splash clocks

Two things kept the first boot from getting anywhere.

The firmware has no UCSI, so the pmic_glink USB-C connector never reports a
data role and the controller is left without one. Pin the role to peripheral
instead: it is what the initramfs gadget uses and host mode is not needed yet.

The splash framebuffer held two clocks fewer than the 9 Pro's, so
clk_disable_unused cut the panel out from under it. The command mode panel then
keeps its last frame and the boot looks hung wherever it happened to be, which
is why the last line moved from boot to boot. Hold the same ten clocks the
9 Pro does.
---
 .../arm64/boot/dts/qcom/sm8350-oneplus-lemonade.dts | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonade.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonade.dts
index f81e61c20..c33b0dd10 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonade.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonade.dts
@@ -73,7 +73,9 @@ &framebuffer {
 		 <&dispcc DISP_CC_MDSS_MDP_LUT_CLK>,
 		 <&dispcc DISP_CC_MDSS_VSYNC_CLK>,
 		 <&dispcc DISP_CC_MDSS_BYTE0_CLK>,
-		 <&dispcc DISP_CC_MDSS_BYTE0_INTF_CLK>;
+		 <&dispcc DISP_CC_MDSS_BYTE0_INTF_CLK>,
+		 <&dispcc DISP_CC_MDSS_PCLK0_CLK>,
+		 <&dispcc DISP_CC_MDSS_ESC0_CLK>;
 };
 
 &mpss {
@@ -104,6 +106,15 @@ &mdss_dsi0_phy {
 	status = "okay";
 };
 
+/*
+ * This firmware has no UCSI, so the pmic_glink USB-C connector never reports a
+ * data role and the role-switch would leave the controller without one. A fixed
+ * peripheral role is what the initramfs gadget needs; host mode is not used.
+ */
+&usb_1_dwc3 {
+	dr_mode = "peripheral";
+};
+
 &tlmm {
 	/* Modem antenna pins exclusive to lemonade */
 	rf_cable_ant1_active: rf-cable-ant1-active-state {
-- 
