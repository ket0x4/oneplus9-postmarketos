From 2bdc84553e1c0c732bd5ab65ec9f93f23f9b12b2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?ibrahim=20y=C3=B6ndemli?= <ket0x4@pm.me>
Date: Fri, 20 Nov 2026 10:18:04 +0300
Subject: [PATCH 160/167] arm64: dts: qcom: sm8350-oneplus-lemonade: add all
 four cameras

Wire the OnePlus 9 (lemonade) camera subsystem from the lemonadev stock DTBO and CamX module data:
- IMX689 main camera on cci0_i2c0 / CSIPHY1 (C-PHY), LC898229 VCM @ 0x72, EEPROM @ 0x50
- IMX766 ultrawide camera on cci0_i2c1 / CSIPHY2 (C-PHY), LC898229 VCM @ 0x72, EEPROM @ 0x51
- GC02M1B mono helper on cci1_i2c0 / CSIPHY0 (MCLK2, rotation 90)
- IMX471 front camera on cci1_i2c1 / CSIPHY5, EEPROM @ 0x54
along with the GPIO-switched fixed camera power rails and TLMM pinctrls.
---
 .../boot/dts/qcom/sm8350-oneplus-lemonade.dts | 402 ++++++++++++++++++
 1 file changed, 402 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonade.dts b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonade.dts
index b9229ba0b..247249fba 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonade.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-oneplus-lemonade.dts
@@ -25,6 +25,79 @@ / {
 	 */
 	oplus,dtsi_no = <0x4d67 0x4d71 0x5176>;
 
+	/* Camera rails: GPIO-switched load switches/LDOs */
+	vreg_cam_main_avdd: regulator-cam-main-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_main_avdd";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 196 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8350c_s1>;
+		pinctrl-0 = <&cam_main_avdd_en>;
+		pinctrl-names = "default";
+	};
+
+	vreg_cam_main_dvdd: regulator-cam-main-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_main_dvdd";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		gpio = <&tlmm 66 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8350_s12>;
+		pinctrl-0 = <&cam_main_dvdd_en>;
+		pinctrl-names = "default";
+	};
+
+	vreg_cam_wide_avdd: regulator-cam-wide-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_wide_avdd";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 93 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8350c_s1>;
+		pinctrl-0 = <&cam_wide_avdd_en>;
+		pinctrl-names = "default";
+	};
+
+	vreg_cam_wide_dvdd: regulator-cam-wide-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_wide_dvdd";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		gpio = <&tlmm 97 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-0 = <&cam_wide_dvdd_en>;
+		pinctrl-names = "default";
+	};
+
+	vreg_cam_mono_avdd: regulator-cam-mono-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_mono_avdd";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 195 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-0 = <&cam_mono_avdd_en>;
+		pinctrl-names = "default";
+	};
+
+	vreg_cam_front_vana: regulator-cam-front-vana {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_front_vana";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 125 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-0 = <&cam_front_vana_en>;
+		pinctrl-names = "default";
+	};
+
 	/*
 	 * Sensor chips and tuning for the OnePlus SLPI sensor drivers, copied
 	 * from the downstream lemonadev oplus_sensor node; oplus-sensor-devinfo
@@ -228,6 +301,237 @@ &display_panel {
 	status = "okay";
 };
 
+&camcc {
+	status = "okay";
+};
+
+&camss {
+	vdda-phy-supply = <&pm8350_l5>;
+	vdda-pll-supply = <&pm8350_l6>;
+	status = "okay";
+
+	ports {
+		/* Main camera on CSIPHY1, C-PHY */
+		port@1 {
+			csiphy1_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				remote-endpoint = <&imx689_ep>;
+			};
+		};
+
+		/* Ultrawide camera on CSIPHY2, C-PHY */
+		port@2 {
+			csiphy2_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				remote-endpoint = <&imx766_ep>;
+			};
+		};
+
+		/* Mono camera on CSIPHY0, one lane */
+		port@0 {
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0>;
+				remote-endpoint = <&gc02m1b_ep>;
+			};
+		};
+
+		/* Front camera on CSIPHY5 */
+		port@5 {
+			csiphy5_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&imx471_ep>;
+			};
+		};
+	};
+};
+
+&cci0 {
+	status = "okay";
+};
+
+&cci0_i2c0 {
+	/* Main camera, Semco IMX689 */
+	camera@1a {
+		compatible = "sony,imx689";
+		reg = <0x1a>;
+
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		reset-gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk0_active>, <&cam_main_reset>;
+		pinctrl-names = "default";
+
+		vio-supply = <&vreg_l5i>;
+		vana-supply = <&vreg_cam_main_avdd>;
+		vana1-supply = <&vreg_l4i>;
+		vdig-supply = <&vreg_cam_main_dvdd>;
+
+		lens-focus = <&main_vcm>;
+
+		rotation = <90>;
+		orientation = <1>;
+
+		port {
+			imx689_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				link-frequencies = /bits/ 64 <421200000 552000000>;
+				remote-endpoint = <&csiphy1_ep>;
+			};
+		};
+	};
+
+	/* Main camera focus motor, onsemi LC898229 */
+	main_vcm: focus@72 {
+		compatible = "onnn,lc898229";
+		reg = <0x72>;
+		vdd-supply = <&vreg_l3i>;
+		vio-supply = <&vreg_l5i>;
+	};
+
+	/* Main camera module calibration */
+	eeprom@50 {
+		compatible = "atmel,24c128";
+		reg = <0x50>;
+		vcc-supply = <&vreg_l5i>;
+		read-only;
+	};
+};
+
+&cci0_i2c1 {
+	/* Ultrawide camera, Sunny IMX766 */
+	camera@1a {
+		compatible = "sony,imx766";
+		reg = <0x1a>;
+
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		reset-gpios = <&tlmm 106 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk1_active>, <&cam_wide_reset>;
+		pinctrl-names = "default";
+
+		vio-supply = <&vreg_l5i>;
+		vana-supply = <&vreg_cam_wide_avdd>;
+		vana1-supply = <&vreg_l7i>;
+		vdig-supply = <&vreg_cam_wide_dvdd>;
+
+		lens-focus = <&wide_vcm>;
+
+		rotation = <90>;
+		orientation = <1>;
+
+		port {
+			imx766_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				link-frequencies = /bits/ 64 <537600000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+
+	/* Ultrawide camera focus motor, onsemi LC898229 */
+	wide_vcm: focus@72 {
+		compatible = "onnn,lc898229";
+		reg = <0x72>;
+		vdd-supply = <&vreg_l6i>;
+		vio-supply = <&vreg_l5i>;
+	};
+
+	/* Ultrawide camera module calibration */
+	eeprom@51 {
+		compatible = "atmel,24c128";
+		reg = <0x51>;
+		vcc-supply = <&vreg_l5i>;
+		read-only;
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c0 {
+	/* Mono camera, Shine GC02M1B */
+	camera@37 {
+		compatible = "galaxycore,gc02m1b";
+		reg = <0x37>;
+
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		reset-gpios = <&tlmm 167 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk2_active>, <&cam_mono_reset>;
+		pinctrl-names = "default";
+
+		dovdd-supply = <&vreg_l5i>;
+		avdd-supply = <&vreg_cam_mono_avdd>;
+
+		rotation = <90>;
+		orientation = <1>;
+
+		port {
+			gc02m1b_ep: endpoint {
+				data-lanes = <1>;
+				link-frequencies = /bits/ 64 <336000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
+&cci1_i2c1 {
+	/* Front camera, Truly IMX471 */
+	camera@10 {
+		compatible = "sony,imx471";
+		reg = <0x10>;
+
+		clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		reset-gpios = <&tlmm 115 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk3_active>, <&cam_front_reset>;
+		pinctrl-names = "default";
+
+		vio-supply = <&vreg_l5i>;
+		vana-supply = <&vreg_cam_front_vana>;
+		vdig-supply = <&vreg_l2i>;
+
+		rotation = <270>;
+		orientation = <0>;
+
+		port {
+			imx471_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <200000000>;
+				remote-endpoint = <&csiphy5_ep>;
+			};
+		};
+	};
+
+	/* Front camera module calibration */
+	eeprom@54 {
+		compatible = "atmel,24c64";
+		reg = <0x54>;
+		vcc-supply = <&vreg_l5i>;
+		read-only;
+	};
+};
+
 &mdss {
 	status = "okay";
 };
@@ -274,6 +578,104 @@ rf_cable_ant7_active: rf-cable-ant7-active-state {
 		bias-pull-up;
 	};
 
+	cam_mclk0_active: cam-mclk0-active-state {
+		pins = "gpio100";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_main_reset: cam-main-reset-state {
+		pins = "gpio16";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_main_avdd_en: cam-main-avdd-en-state {
+		pins = "gpio196";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_main_dvdd_en: cam-main-dvdd-en-state {
+		pins = "gpio66";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk1_active: cam-mclk1-active-state {
+		pins = "gpio101";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_wide_reset: cam-wide-reset-state {
+		pins = "gpio106";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_wide_avdd_en: cam-wide-avdd-en-state {
+		pins = "gpio93";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_wide_dvdd_en: cam-wide-dvdd-en-state {
+		pins = "gpio97";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk2_active: cam-mclk2-active-state {
+		pins = "gpio102";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mono_reset: cam-mono-reset-state {
+		pins = "gpio167";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mono_avdd_en: cam-mono-avdd-en-state {
+		pins = "gpio195";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk3_active: cam-mclk3-active-state {
+		pins = "gpio103";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_front_reset: cam-front-reset-state {
+		pins = "gpio115";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_front_vana_en: cam-front-vana-en-state {
+		pins = "gpio125";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	tp_enable_2v8: tp-2v8-enable-state {
 		pins = "gpio74";
 		function = "gpio";
-- 
