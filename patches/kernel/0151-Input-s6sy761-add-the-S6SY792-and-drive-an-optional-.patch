From 644c3fdd732ae91874db9322f34f4c68d7d20130 Mon Sep 17 00:00:00 2001
From: Nex <63727521+LuCiLuna@users.noreply.github.com>
Date: Wed, 18 Nov 2026 23:19:03 +0300
Subject: [PATCH 151/167] Input: s6sy761: add the S6SY792 and drive an optional reset
 line

The OnePlus 9 uses Samsung's S6SY792 instead of the 9 Pro's Synaptics
controller. It answers the same commands and reports the same 8-byte events as
the S6SY761 this driver already handles; it adds gestures and grip zones, none
of which are used here. Name the input device after whichever one matched.

The reset line is optional because some boards leave the controller running
from the bootloader, where pulsing it breaks the DSI link rather than fixing
anything.
---
 .../input/touchscreen/samsung,s6sy761.yaml    |  9 ++++-
 drivers/input/touchscreen/s6sy761.c           | 38 +++++++++++++++++--
 2 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/input/touchscreen/samsung,s6sy761.yaml b/Documentation/devicetree/bindings/input/touchscreen/samsung,s6sy761.yaml
index 1ffd17af3..f3a2c4188 100644
--- a/Documentation/devicetree/bindings/input/touchscreen/samsung,s6sy761.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/samsung,s6sy761.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/input/touchscreen/samsung,s6sy761.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Samsung S6SY761 touchscreen controller
+title: Samsung S6SY761 and S6SY792 touchscreen controllers
 
 maintainers:
   - Andi Shyti <andi.shyti@kernel.org>
@@ -14,7 +14,9 @@ allOf:
 
 properties:
   compatible:
-    const: samsung,s6sy761
+    enum:
+      - samsung,s6sy761
+      - samsung,s6sy792
 
   reg:
     maxItems: 1
@@ -25,6 +27,9 @@ properties:
   avdd-supply: true
   vdd-supply: true
 
+  reset-gpios:
+    maxItems: 1
+
 unevaluatedProperties: false
 
 required:
diff --git a/drivers/input/touchscreen/s6sy761.c b/drivers/input/touchscreen/s6sy761.c
index 899c179fb..7db6e8ef2 100644
--- a/drivers/input/touchscreen/s6sy761.c
+++ b/drivers/input/touchscreen/s6sy761.c
@@ -6,6 +6,7 @@
 
 #include <linux/unaligned.h>
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/input/mt.h>
 #include <linux/input/touchscreen.h>
@@ -92,6 +93,7 @@
 #define S6SY761_MAX_FINGERS		10
 
 #define S6SY761_DEV_NAME	"s6sy761"
+#define S6SY792_DEV_NAME	"s6sy792"
 
 enum s6sy761_regulators {
 	S6SY761_REGULATOR_VDD,
@@ -108,6 +110,8 @@ struct s6sy761_data {
 
 	u16 devid;
 	u8 tx_channel;
+	const char *dev_name;
+	struct gpio_desc *reset_gpio;
 };
 
 /*
@@ -299,6 +303,18 @@ static int s6sy761_power_on(struct s6sy761_data *sdata)
 	if (ret)
 		return ret;
 
+	/*
+	 * Some boards have the reset line wired to the controller even though
+	 * the bootloader may leave it released; pulse it so the controller
+	 * starts from a known state.
+	 */
+	if (sdata->reset_gpio) {
+		gpiod_set_value_cansleep(sdata->reset_gpio, 0);
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(sdata->reset_gpio, 1);
+		usleep_range(1000, 2000);
+	}
+
 	msleep(140);
 
 	/* double check whether the touch is functional */
@@ -403,9 +419,18 @@ static int s6sy761_probe(struct i2c_client *client)
 
 	i2c_set_clientdata(client, sdata);
 	sdata->client = client;
+	sdata->dev_name = i2c_get_match_data(client);
+	if (!sdata->dev_name)
+		sdata->dev_name = S6SY761_DEV_NAME;
 
 	sdata->regulators[S6SY761_REGULATOR_VDD].supply = "vdd";
 	sdata->regulators[S6SY761_REGULATOR_AVDD].supply = "avdd";
+
+	sdata->reset_gpio = devm_gpiod_get_optional(&client->dev, "reset",
+						    GPIOD_OUT_LOW);
+	if (IS_ERR(sdata->reset_gpio))
+		return PTR_ERR(sdata->reset_gpio);
+
 	err = devm_regulator_bulk_get(&client->dev,
 				      ARRAY_SIZE(sdata->regulators),
 				      sdata->regulators);
@@ -424,7 +449,7 @@ static int s6sy761_probe(struct i2c_client *client)
 	if (!sdata->input)
 		return -ENOMEM;
 
-	sdata->input->name = S6SY761_DEV_NAME;
+	sdata->input->name = sdata->dev_name;
 	sdata->input->id.bustype = BUS_I2C;
 	sdata->input->open = s6sy761_input_open;
 	sdata->input->close = s6sy761_input_close;
@@ -524,15 +549,22 @@ static const struct dev_pm_ops s6sy761_pm_ops = {
 };
 
 #ifdef CONFIG_OF
+/*
+ * The S6SY792 answers the same commands and reports the same 8-byte events as
+ * the S6SY761; it differs in the panel information it reports and in what it
+ * supports (gestures, grip zones), none of which this driver uses.
+ */
 static const struct of_device_id s6sy761_of_match[] = {
-	{ .compatible = "samsung,s6sy761", },
+	{ .compatible = "samsung,s6sy761", .data = S6SY761_DEV_NAME },
+	{ .compatible = "samsung,s6sy792", .data = S6SY792_DEV_NAME },
 	{ },
 };
 MODULE_DEVICE_TABLE(of, s6sy761_of_match);
 #endif
 
 static const struct i2c_device_id s6sy761_id[] = {
-	{ .name = "s6sy761" },
+	{ .name = "s6sy761", .driver_data = (kernel_ulong_t)S6SY761_DEV_NAME },
+	{ .name = "s6sy792", .driver_data = (kernel_ulong_t)S6SY792_DEV_NAME },
 	{ }
 };
 MODULE_DEVICE_TABLE(i2c, s6sy761_id);
-- 
