 #include <sys/ioctl.h>
 #include <utility>
 
@@ -735,6 +739,14 @@ int DebayerCpu::configure(const StreamConfiguration &inputCfg,
 
 	ccmEnabled_ = ccmEnabled;
 
+	const PixelFormatInfo &outInfo = PixelFormatInfo::info(outputCfg.pixelFormat);
+	postBpp_ = outInfo.bitsPerPixel / 8;
+	postWidth_ = outputCfg.size.width;
+	postHeight_ = outputCfg.size.height;
