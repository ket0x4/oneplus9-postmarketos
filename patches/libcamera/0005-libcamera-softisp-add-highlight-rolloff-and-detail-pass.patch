diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index 300c3f2..37c3092 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -25,6 +25,19 @@ struct DebayerParams {
 	RGB<double> blackLevel = RGB<double>({ 0.0, 0.0, 0.0 });
 	float gamma = 1.0;
 	float contrastExp = 1.0;
+	/*
+	 * Highlight rolloff: channel values are compressed above this knee
+	 * instead of being clipped, so detail in the brightest parts survives.
+	 * 1.0 disables the compression (the old hard-clip behaviour).
+	 */
+	float highlightKnee = 1.0f;
+	/*
+	 * Post-debayer detail processing. sharpen pulls the value away from a
+	 * local blur on edges, denoise blends it towards the blur on flat
+	 * areas. Both are 0..1-ish and 0 keeps the pass disabled.
+	 */
+	float sharpen = 0.0f;
+	float denoise = 0.0f;
 	RGB<double> gains = RGB<double>({ 1.0, 1.0, 1.0 });
 
 	/**
diff --git a/src/ipa/softisp/algorithms/adjust.cpp b/src/ipa/softisp/algorithms/adjust.cpp
index 56e2cf0..7aab74a 100644
--- a/src/ipa/softisp/algorithms/adjust.cpp
+++ b/src/ipa/softisp/algorithms/adjust.cpp
@@ -24,8 +24,18 @@ constexpr float kDefaultSaturation = 1.0f;
 
 LOG_DEFINE_CATEGORY(IPASoftIspAdjust)
 
-int Adjust::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+int Adjust::init(IPAContext &context, const ValueNode &tuningData)
 {
+	/*
+	 * Where the highlight shoulder starts, in normalised linear range.
+	 * 1.0 keeps the historical hard clip; below that the brightest values
+	 * are compressed so they don't clip to white.
+	 */
+	highlightKnee_ = std::clamp(tuningData["highlightKnee"].get<double>(1.0),
+				    0.0, 1.0);
+	sharpen_ = std::clamp(tuningData["sharpen"].get<double>(0.0), 0.0, 2.0);
+	denoise_ = std::clamp(tuningData["denoise"].get<double>(0.0), 0.0, 1.0);
+
 	context.ctrlMap[&controls::Gamma] =
 		ControlInfo(0.1f, 10.0f, kDefaultGamma);
 	context.ctrlMap[&controls::Contrast] =
@@ -109,6 +119,9 @@ void Adjust::prepare(IPAContext &context,
 	params->gamma = 1.0 / context.activeState.knobs.gamma;
 	const float contrast = context.activeState.knobs.contrast.value_or(kDefaultContrast);
 	params->contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
+	params->highlightKnee = highlightKnee_;
+	params->sharpen = sharpen_;
+	params->denoise = denoise_;
 }
 
 void Adjust::process([[maybe_unused]] IPAContext &context,
