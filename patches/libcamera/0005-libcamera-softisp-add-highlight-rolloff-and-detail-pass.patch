index e613340..76b51ac 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -70,6 +70,7 @@ uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
+uniform float highlightKnee;
 
 #if defined(APPLY_LSC)
 uniform sampler2D lsc_tex;
@@ -248,7 +249,20 @@ void main(void)
 	rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
 
 	/* Colour Correction Matrix */
-	rgb = ccm * rgb;
+	rgb = max(ccm * rgb, vec3(0.0));
+
+	/*
+	 * Highlight rolloff. Compress the brightest values above the knee on
+	 * the luma so the colour ratios (and thus the hue) stay put, instead of
+	 * letting them clip hard to white.
+	 */
+	float luma = max(rgb.r, max(rgb.g, rgb.b));
+	if (highlightKnee < 1.0 && luma > highlightKnee) {
+		float compressed = highlightKnee +
+			(1.0 - highlightKnee) *
+			(1.0 - exp(-(luma - highlightKnee) / (1.0 - highlightKnee)));
+		rgb *= compressed / luma;
+	}
 
 	/*
 	 * Contrast
