 	LOG(Debayer, Debug) << " contrastExpUniformDataIn_ " << contrastExpUniformDataIn_ << " data " << params.contrastExp;
 
+	/*
+	 * Highlight rolloff
+	 */
+	glUniform1f(highlightKneeUniformDataIn_, params.highlightKnee);
+	LOG(Debayer, Debug) << " highlightKneeUniformDataIn_ " << highlightKneeUniformDataIn_ << " data " << params.highlightKnee;
+
 	return;
 }
 
