@@ -1106,6 +1128,146 @@ void DebayerCpu::updateLookupTables(const DebayerParams &params)
 	params_ = params;
 }
 
+/*
+ * A detail pass over the debayered output: an edge-preserving denoise followed
+ * by an unsharp mask.
+ *
+ * The denoise weights each neighbour of a 3x3 window by how similar its luma
+ * is to the centre, so flat (noisy) areas are averaged while real edges keep
+ * their neighbours at arm's length. The unsharp then works on the denoised
+ * result, so it sharpens real detail instead of amplifying the noise that was
+ * just removed. The luma is the mean of the stored channels, which makes this
+ * independent of the RGB/BGR byte order (a constant alpha or X byte drops out
+ * of the difference).
+ */
+void DebayerCpu::postProcess(uint8_t *data)
+{
+	const float sharpen = params_.sharpen;
+	const float denoise = params_.denoise;
+
+	if ((sharpen <= 0.0f && denoise <= 0.0f) || postBpp_ == 0 ||
+	    postWidth_ < 3 || postHeight_ < 3)
+		return;
+
+	const unsigned int w = postWidth_;
+	const unsigned int h = postHeight_;
+	const unsigned int stride = postStride_;
+	const unsigned int bpp = postBpp_;
+	const size_t bytes = static_cast<size_t>(stride) * h;
+
+	postSrc_.resize(bytes);
+	memcpy(postSrc_.data(), data, bytes);
+	const uint8_t *src = postSrc_.data();
+
+	auto parallelRows = [&](auto &&fn) {
+		const unsigned int nThreads = std::clamp<unsigned int>(threads_.size(), 1, 8);
+		if (nThreads == 1) {
+			fn(0, h);
+			return;
+		}
+
+		std::vector<std::thread> workers;
+		workers.reserve(nThreads);
+		for (unsigned int i = 0; i < nThreads; i++)
+			workers.emplace_back(fn, h * i / nThreads, h * (i + 1) / nThreads);
+		for (auto &worker : workers)
+			worker.join();
+	};
+
+	if (denoise > 0.0f) {
+		postDen_.resize(bytes);
+		uint8_t *den = postDen_.data();
+
+		parallelRows([&](unsigned int yStart, unsigned int yEnd) {
+			/* Luma difference at which a neighbour stops counting. */
+			constexpr float kSigma = 16.0f;
+			constexpr float kWeight = 1.0f / (kSigma * kSigma);
+
+			for (unsigned int y = yStart; y < yEnd; y++) {
+				const unsigned int ym = y ? y - 1 : 0;
+				const unsigned int yp = y < h - 1 ? y + 1 : h - 1;
+				const uint8_t *r0 = src + ym * stride;
+				const uint8_t *r1 = src + y * stride;
+				const uint8_t *r2 = src + yp * stride;
+				uint8_t *dst = den + y * stride;
+
+				for (unsigned int x = 0; x < w; x++) {
+					const unsigned int xm = x ? x - 1 : 0;
+					const unsigned int xp = x < w - 1 ? x + 1 : w - 1;
+					const uint8_t *e = &r1[x * bpp];
+					const uint8_t *n[9] = {
+						&r0[xm * bpp], &r0[x * bpp], &r0[xp * bpp],
+						&r1[xm * bpp], &r1[x * bpp], &r1[xp * bpp],
+						&r2[xm * bpp], &r2[x * bpp], &r2[xp * bpp],
+					};
+
+					float centreLuma = 0.0f;
+					for (unsigned int ch = 0; ch < bpp; ch++)
+						centreLuma += e[ch];
+					centreLuma /= bpp;
+
+					float sum[4] = {}, weightSum = 0.0f;
+					for (unsigned int k = 0; k < 9; k++) {
+						float luma = 0.0f;
+						for (unsigned int ch = 0; ch < bpp; ch++)
+							luma += n[k][ch];
+						luma /= bpp;
+
+						const float d = luma - centreLuma;
+						const float weight = 1.0f / (1.0f + d * d * kWeight);
+
+						for (unsigned int ch = 0; ch < bpp; ch++)
+							sum[ch] += weight * n[k][ch];
+						weightSum += weight;
+					}
+
+					for (unsigned int ch = 0; ch < bpp; ch++) {
+						const float blurred = sum[ch] / weightSum;
+						const float v = e[ch] * (1.0f - denoise) +
+								blurred * denoise;
+						dst[x * bpp + ch] = static_cast<uint8_t>(
+							std::clamp(v, 0.0f, 255.0f));
+					}
+				}
+			}
+		});
+
+		src = den;
+	}
+
+	if (sharpen > 0.0f) {
+		parallelRows([&](unsigned int yStart, unsigned int yEnd) {
+			for (unsigned int y = yStart; y < yEnd; y++) {
+				const unsigned int ym = y ? y - 1 : 0;
+				const unsigned int yp = y < h - 1 ? y + 1 : h - 1;
+				const uint8_t *r0 = src + ym * stride;
+				const uint8_t *r1 = src + y * stride;
+				const uint8_t *r2 = src + yp * stride;
+				uint8_t *dst = data + y * stride;
+
+				for (unsigned int x = 0; x < w; x++) {
+					const unsigned int xm = x ? x - 1 : 0;
+					const unsigned int xp = x < w - 1 ? x + 1 : w - 1;
+					const uint8_t *a = &r0[xm * bpp], *b = &r0[x * bpp], *c = &r0[xp * bpp];
+					const uint8_t *d = &r1[xm * bpp], *e = &r1[x * bpp], *f = &r1[xp * bpp];
+					const uint8_t *g = &r2[xm * bpp], *q = &r2[x * bpp], *i = &r2[xp * bpp];
+
+					for (unsigned int ch = 0; ch < bpp; ch++) {
+						const float blur = (a[ch] + 2 * b[ch] + c[ch] +
+								    2 * (d[ch] + 2 * e[ch] + f[ch]) +
+								    g[ch] + 2 * q[ch] + i[ch]) / 16.0f;
+						const float v = e[ch] + sharpen * (e[ch] - blur);
+						dst[x * bpp + ch] = static_cast<uint8_t>(
+							std::clamp(v, 0.0f, 255.0f));
+					}
+				}
+			}
+		});
+	} else {
+		memcpy(data, src, bytes);
+	}
+}
+
 void DebayerCpu::process(uint32_t frame, FrameBuffer *input, FrameBuffer *output, const DebayerParams &params)
 {
 	bench_.startFrame();
@@ -1148,6 +1310,8 @@ void DebayerCpu::process(uint32_t frame, FrameBuffer *input, FrameBuffer *output
 		});
 	}
 
+	postProcess(out.planes()[0].data());
+
 	metadata.planes()[0].bytesused = out.planes()[0].size();
 
 	dmaSyncers.clear();
