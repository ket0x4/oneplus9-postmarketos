 src/libcamera/software_isp/debayer_cpu.cpp    | 60 +++++++++++++++++++
 src/libcamera/software_isp/debayer_cpu.h      |  4 ++
 src/libcamera/software_isp/swstats_cpu.cpp    | 28 +++++++++
 4 files changed, 94 insertions(+)

