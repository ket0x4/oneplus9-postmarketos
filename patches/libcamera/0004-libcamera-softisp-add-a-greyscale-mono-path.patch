diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index 7882bd7..e78ca66 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -302,6 +302,28 @@ void SwStatsCpu::statsBGGR12Line0(const uint8_t *src[], SwIspStats &stats, bool
 	SWSTATS_FINISH_LINE_STATS()
 }
 
+void SwStatsCpu::statsMono10PLine0(const uint8_t *src[], SwIspStats &stats, bool afLine)
+{
+	const uint8_t *src0 = src[1] + window_.x * 5 / 4;
+	const unsigned int widthInBytes = window_.width * 5 / 4;
+
+	SWSTATS_START_LINE_STATS(uint8_t)
+
+	for (unsigned int x = 0; x < widthInBytes; x += 5) {
+		/* Four grey pixels share the fifth byte's low bits */
+		for (unsigned int i = 0; i < 4; i++) {
+			unsigned int value = (src0[x + i] << 2) | ((src0[x + 4] >> (2 * i)) & 0x3);
+
+			r = value >> 2;
+			g = value >> 2;
+			b = value >> 2;
+			SWSTATS_ACCUMULATE_LINE_STATS(1)
+		}
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
 void SwStatsCpu::statsBGGR10PLine0(const uint8_t *src[], SwIspStats &stats, bool afLine)
 {
 	const uint8_t *src0 = src[1] + window_.x * 5 / 4;
@@ -549,6 +571,12 @@ int SwStatsCpu::configure(const StreamConfiguration &inputCfg, unsigned int stat
 		sumShift_ = 0;
 		processFrame_ = &SwStatsCpu::processBayerFrame2;
 
+		if (bitDepth == 10 && bayerFormat.order == BayerFormat::MONO) {
+			stats0_ = &SwStatsCpu::statsMono10PLine0;
+			swapLines_ = false;
+			return 0;
+		}
+
