 	/* Bayer 10 bpp packed */
 	void statsBGGR10PLine0(const uint8_t *src[], SwIspStats &stats, bool afLine);
 	void statsGBRG10PLine0(const uint8_t *src[], SwIspStats &stats, bool afLine);
diff --git a/src/libcamera/software_isp/debayer_cpu.cpp b/src/libcamera/software_isp/debayer_cpu.cpp
index 91867ba..1dc436c 100644
--- a/src/libcamera/software_isp/debayer_cpu.cpp
+++ b/src/libcamera/software_isp/debayer_cpu.cpp
@@ -193,6 +193,40 @@ DebayerCpu::~DebayerCpu() = default;
 		(prev[x] + curr[x - p] + curr[x + n] + next[x]) / (4 * (div)),         \
 		curr[x] / (div))
 
+template<bool addAlphaByte, bool ccmEnabled>
+void DebayerCpu::debayerMono10P_R8(uint8_t *dst, const uint8_t *src[])
+{
+	const int widthInBytes = window_.width * 5 / 4;
+	const uint8_t *curr = src[1];
+
+	/*
+	 * R10_CSI2P stores 4 pixels in 5 bytes: the first four hold the top 8
+	 * bits of each pixel's 10-bit value, the fifth the two least-significant
+	 * bits of all four, two per pixel, least-significant first. There is no
+	 * colour to interpolate, so every pixel becomes a grey value in all
+	 * three channels.
+	 */
+	for (int x = 0; x < widthInBytes; x += 5) {
+		for (unsigned int i = 0; i < 4; i++) {
+			unsigned int value = (curr[x + i] << 2) | ((curr[x + 4] >> (2 * i)) & 0x3);
+			int grey = value >> 2; /* 10 -> 8 bpp, like the bayer paths */
+
+			if constexpr (ccmEnabled) {
+				GAMMA(grey);
+				GAMMA(grey);
+				GAMMA(grey);
+			} else {
+				*dst++ = grey;
+				*dst++ = grey;
+				*dst++ = grey;
+			}
+
+			if constexpr (addAlphaByte)
+				*dst++ = 255;
+		}
+	}
+}
+
 template<bool addAlphaByte, bool ccmEnabled>
 void DebayerCpu::debayer8_BGBG_BGR888(uint8_t *dst, const uint8_t *src[])
 {
@@ -470,6 +504,21 @@ int DebayerCpu::getInputConfig(PixelFormat inputFormat, DebayerInputConfig &conf
 		return 0;
 	}
 
+	/*
+	 * Greyscale sensors have no colour to interpolate, so there is nothing to
+	 * debayer: each pixel is copied to all three channels. Only a single
+	 * processed format makes sense for them.
+	 */
+	if (bayerFormat.bitDepth == 10 &&
+	    bayerFormat.packing == BayerFormat::Packing::CSI2 &&
+	    bayerFormat.order == BayerFormat::MONO) {
+		config.bpp = 10;
+		config.patternSize.width = 4; /* 5 bytes per *4* pixels */
+		config.patternSize.height = 2;
+		config.outputFormats = { formats::RGB888, formats::XRGB8888 };
+		return 0;
+	}
+
 	LOG(Debayer, Debug)
 		<< "Unsupported input format " << inputFormat;
 	return -EINVAL;
@@ -579,6 +628,17 @@ int DebayerCpu::setDebayerFunctions(PixelFormat inputFormat,
 		return 0;
 	}
 
+	if (bayerFormat.bitDepth == 10 &&
+	    bayerFormat.packing == BayerFormat::Packing::CSI2 &&
+	    bayerFormat.order == BayerFormat::MONO) {
+		/*
+		 * Greyscale has no neighbour to interpolate from, so the same
+		 * per-line function handles both lines of the pattern.
+		 */
+		SET_DEBAYER_METHODS(debayerMono10P_R8, debayerMono10P_R8)
+		return 0;
+	}
+
 	if (bayerFormat.bitDepth == 10 &&
 	    bayerFormat.packing == BayerFormat::Packing::CSI2) {
 		switch (bayerFormat.order) {
