# kernel/build.sh hashes the concatenated patch bytes to decide whether the
# series needs re-applying, and `git am` requires the patches' exact bytes to
# apply. A CRLF conversion on checkout would both flare a full rebuild and
# corrupt the series, so patches are never translated.
*.patch -text
*.diff  -text

# Shell scripts, units and configs must keep LF: they run on the phone, and
# systemd/udev/shell do not accept CRLF line endings.
*.sh     text eol=lf
*.service text eol=lf
*.timer  text eol=lf
*.rules  text eol=lf
*.conf   text eol=lf
*.nft    text eol=lf
init     text eol=lf
PKGBUILD text eol=lf

# Firmware, images and other binaries are not diffs.
*.img   binary
*.mbn   binary
*.mdt   binary
*.dtb   binary
*.dtbo  binary
*.elf   binary
*.zst   binary
