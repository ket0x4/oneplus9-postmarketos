d462a7579f289fcfd450fee9397f278d91c1353c6a20df1d4cc9b1ee75fa17af80c7fc4500fb0983892364f67979bae914d28817e75adc4bbf93a245b9e20d7d  0001-shared-qmi-register-as-LOC-master-client-before-star.patch
"
