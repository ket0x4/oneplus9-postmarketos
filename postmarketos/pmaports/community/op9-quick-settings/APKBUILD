# Maintainer: ibrahim yöndemli <ket0x4@pm.me>
# The quick settings this port adds, for both the Phosh and the Plasma Mobile
# shells:
#
#   touch rate      120 Hz or 360 Hz (stock only uses 360 in game mode)
#   Natural colour  sRGB instead of the panel's wide Display P3 gamut
#
# The Phosh plugins are shared modules built against the installed Phosh's source
# (they use its classes), so they need a rebuild when Phosh moves. The Plasma
# Mobile settings are QML and need no building.
#
# Both knobs are in sysfs, so the choice is also saved to ~/.config/op9-tuning.ini
# and re-applied at login by op9-tuning-restore.service.
pkgname=op9-quick-settings
pkgver=1
pkgrel=1
pkgdesc="OnePlus 9 quick settings for Phosh and Plasma Mobile"
url="https://github.com/ket0x4/oneplus9-postmarketos"
arch="aarch64"
license="GPL-3.0-or-later"
depends="gtk+3.0 libhandy1 glib kconfig"
# phosh-dev is deliberately NOT a makedepends: it is not packaged in every
# postmarketOS image (and not at all on a Plasma-only one). The Phosh plugins
# build only when it is installed; the Plasma settings always install.
makedepends="meson samurai glib-dev gtk+3.0-dev libhandy1-dev"
# Keep in step with the phosh version the plugins build against.
_phoshver=0.59.0
source="meson.build
	meson_options.txt
	op9-quick-setting.c
	quick-setting.plugin.in
	op9-tuning-restore
	op9-tuning-restore.service
	touchrate.qml
	touchrate.metadata.json
	naturalcolour.qml
	naturalcolour.metadata.json
	phosh-$_phoshver.tar.xz::https://sources.phosh.mobi/releases/phosh/phosh-$_phoshver.tar.xz"

build() {
	# The Phosh plugins need phosh's own classes: phosh-dev installs phosh-plugin.h
	# but PhoshQuickSetting lives in phosh's src/, which no distro ships, so the
	# tarball is unpacked next to the sources. Meson rejects absolute include
	# paths, so phosh_src is relative to src/.
	if [ -e /usr/lib/pkgconfig/phosh-plugins.pc ]; then
		mkdir -p src
		cp meson.build meson_options.txt op9-quick-setting.c quick-setting.plugin.in src/
		meson setup "$srcdir/build" src \
			--prefix=/usr \
			--buildtype=plain \
			-D phosh_src="../phosh-$_phoshver"
		meson compile -C "$srcdir/build"
	fi
}


package() {
	if [ -d "$srcdir/build" ]; then
		DESTDIR="$pkgdir" meson install -C "$srcdir/build"
	else
		echo "note: phosh-plugins not installed, so the Phosh plugins are skipped"
	fi

	# The Plasma Mobile quick settings. Each is a KPackage: a metadata.json and
	# contents/ui/main.qml, installed under share/plasma/quicksettings/<id>/.
	for id in touchrate naturalcolour; do
		install -Dm644 "$srcdir/$id.metadata.json" \
			"$pkgdir/usr/share/plasma/quicksettings/org.op9.quicksetting.$id/metadata.json"
		install -Dm644 "$srcdir/$id.qml" \
			"$pkgdir/usr/share/plasma/quicksettings/org.op9.quicksetting.$id/contents/ui/main.qml"
	done

	install -Dm755 "$srcdir/op9-tuning-restore" "$pkgdir/usr/bin/op9-tuning-restore"
	install -Dm644 "$srcdir/op9-tuning-restore.service" \
		"$pkgdir/usr/lib/systemd/user/op9-tuning-restore.service"
}

