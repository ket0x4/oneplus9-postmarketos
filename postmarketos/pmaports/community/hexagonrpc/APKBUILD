0b1fac77ca08dc6ca5322f199d1d13a29ff01784c3086b75f0cdcc42373c5666bfff847b4c3cd1458ce15f66fefe2c694c8ae99c9487cb432d37cbc9f551e5c4  0001-rpcd-apps_std-support-writing-files-in-mapped-direct.patch
