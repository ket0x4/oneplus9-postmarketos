# Maintainer: ibrahim yöndemli <ket0x4@pm.me>
# hexagonrpcd with the registry-write patches this phone's sensors need. The
# SLPI file server is what lets iio-sensor-proxy read the DSP's calibration, and
# upstream can't write into its registry; the two patches here add that.
# Not in Alpine or postmarketOS, so this is a forked package.
pkgname=hexagonrpc
pkgver=0.5.0
_pkgver=0.5.0
_commit=da7a3742ab8d5273a281b70ee11f16fb2cb6a690
pkgrel=0
pkgdesc="FastRPC server for Qualcomm DSPs, with OnePlus 9 registry-write patches"
url="https://github.com/linux-msm/hexagonrpc"
arch="aarch64"
license="GPL-3.0-or-later"
depends=""
makedepends="meson samurai glib-dev"
subpackages="$pkgname-doc"
source="$pkgname-$_pkgver.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/$_commit.tar.gz
	0001-rpcd-apps_std-support-writing-files-in-mapped-direct.patch
	0002-rpcd-listener-fetch-input-buffers-larger-than-256-by.patch
	hexagonrpc.sysusers"
builddir="$srcdir/hexagonrpc-$_commit"

prepare() {
	default_prepare
}

build() {
	meson setup "$builddir/build" "$builddir" \
		--prefix=/usr \
		--buildtype=plain
	meson compile -C "$builddir/build"
}

package() {
	DESTDIR="$pkgdir" meson install -C "$builddir/build"
	install -Dm644 "$srcdir/hexagonrpc.sysusers" \
		"$pkgdir/usr/lib/sysusers.d/hexagonrpc.conf"
}

sha512sums="
