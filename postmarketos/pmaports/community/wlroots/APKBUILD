# Maintainer: ibrahim yöndemli <ket0x4@pm.me>
# wlroots 0.20 with the layer-shell patch this port needs: a 0-dimension
# surface without an anchor is an error upstream, but Phosh's home bar creates
# one, and wlroots aborts the client (Phosh then crashes).
pkgname=wlroots0.20
pkgver=0.20.2
pkgrel=0
pkgdesc="Modular Wayland compositor library, with the OnePlus 9 layer-shell fix"
url="https://gitlab.freedesktop.org/wlroots/wlroots"
arch="aarch64"
license="MIT"
depends="libdisplay-info libdrm libinput lcms2 libliftoff pixman seatd
	wayland mesa-egl mesa-gl vulkan-loader libxcb libxkbcommon"
makedepends="meson samurai wayland-dev wayland-protocols libinput-dev libdrm-dev
	pixman-dev libxcb-dev libxkbcommon-dev libdisplay-info-dev lcms2-dev
	seatd glslang-dev vulkan-headers mesa-dev"
subpackages="$pkgname-dev"
# Alpine ships no wlroots 0.20, so this does not replace anything.
source="wlroots-$pkgver.tar.gz::https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/$pkgver/wlroots-$pkgver.tar.gz
	0001-Revert-layer-shell-error-on-0-dimension-without-anch.patch"
builddir="$srcdir/wlroots-$pkgver"

prepare() {
	default_prepare
}

build() {
	meson setup "$builddir/build" "$builddir" \
		--prefix=/usr \
		--buildtype=plain
	meson compile -C "$builddir/build"
}

package() {
	DESTDIR="$pkgdir" meson install -C "$builddir/build"
	install -Dm644 "$builddir/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

sha512sums="
