4ae9b801d3bbda0fe064fac34855b37c170785b185ae8e860dc6e6adb7f87a0e43d17d4a792d1bc506579e1dad07132529429084a62698d4715478393a641194  0001-Revert-layer-shell-error-on-0-dimension-without-anch.patch
"
