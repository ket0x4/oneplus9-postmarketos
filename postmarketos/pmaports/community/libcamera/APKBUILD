# Maintainer: ibrahim yöndemli <ket0x4@pm.me>
# libcamera with the software-ISP patches this port needs: a correctly centred
# debayer for the scaled-down mantis, the OnePlus 9 sensor gain helpers (IMX689,
# IMX766, IMX471, GC02M1B), contrast-detect autofocus, a greyscale path for the
# mono camera, and a tunable highlight-rolloff plus sharpen/denoise detail pass.
# Replaces Alpine's libcamera so the -ipa subpackage comes from the same build.
pkgname=libcamera
pkgver=0.8.0
pkgrel=0
pkgdesc="Camera support library, with OnePlus 9 software-ISP patches"
url="https://libcamera.org/"
arch="aarch64"
license="LGPL-2.1-or-later AND GPL-2.0-or-later AND BSD-2-Clause"
depends=""
makedepends="meson samurai libdrm-dev mesa-dev libjpeg-turbo-dev tiff-dev
	openssl-dev py3-jinja2 py3-ply py3-yaml python3-dev libevent-dev"
options="!strip"
# The same version replaces Alpine's package, so the tools and IPA helpers keep a
# single source. Without this, apk would install both and the IPA signature check
# would fail against the wrong library.
# Do NOT provides="libcamera-ipa": that claims the subpackage is already
# satisfied, so apk never installs it and libcamera logs "No IPA found".
replaces="libcamera libcamera-ipa"
subpackages="$pkgname-ipa $pkgname-tools $pkgname-dev"
source="libcamera-$pkgver.tar.gz::https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$pkgver/libcamera-v$pkgver.tar.gz
	0001-libcamera-software_isp-debayer_egl-centre-the-scaled.patch
	0002-libipa-camera_sensor_helper-add-OnePlus-9-Pro-sensor.patch
	0003-ipa-softisp-add-contrast-detection-auto-focus.patch
	0004-libcamera-softisp-add-a-greyscale-mono-path.patch
	0005-libcamera-softisp-add-highlight-rolloff-and-detail-pass.patch
	0006-libcamera-softisp-gpu-debayer-keeps-low-bits-mono-detail.patch
	0007-libcamera-softisp-malvar-he-cutler-demosaic.patch"
builddir="$srcdir/libcamera-v$pkgver"

prepare() {
	default_prepare
	# utils/gen-version.sh reads this when the tree has no git metadata
	printf '%s\n' "$pkgver" > "$builddir/.tarball-version"
}

build() {
	# Only what this phone uses, plus USB webcams. GCC warns inside libcamera's
	# own headers, so werror stays off.
	meson setup "$builddir/build" "$builddir" \
		--prefix=/usr \
		--buildtype=plain \
		-D pipelines=simple,uvcvideo \
		-D ipas=softisp \
		-D softisp-gpu=enabled \
		-D v4l2=enabled \
		-D werror=false \
		-D tracing=disabled \
		-D test=false \
		-D documentation=disabled \
		-D gstreamer=disabled \
		-D pycamera=disabled \
		-D cam=enabled \
		-D qcam=disabled \
		-D lc-compliance=disabled
	meson compile -C "$builddir/build"
}

package() {
	DESTDIR="$pkgdir" meson install -C "$builddir/build"
}

ipa() {
	pkgdesc="libcamera IPA modules"
	depends="$pkgname"
	# meson installs these as usr/lib/libcamera/ipa/*.so, so move the directory
	# itself. A glob on "ipa*" under usr/lib/libcamera never matched, which left
	# the modules in the main package and made libcamera log "No IPA found".
	if [ -d "$pkgdir/usr/lib/libcamera/ipa" ]; then
		install -d "$subpkgdir/usr/lib/libcamera"
		mv "$pkgdir/usr/lib/libcamera/ipa" "$subpkgdir/usr/lib/libcamera/"
	fi
	# The soft ISP proxy stays with the library, not the IPA modules.
	if [ -d "$pkgdir/usr/lib/libcamera" ]; then
		rmdir "$pkgdir/usr/lib/libcamera" 2>/dev/null || true
	fi
}

tools() {
	pkgdesc="libcamera command-line tools"
	depends="$pkgname"
	mkdir -p "$subpkgdir/usr/bin"
	mv "$pkgdir"/usr/bin/* "$subpkgdir/usr/bin/" 2>/dev/null || true
}

dev() {
	default_dev
	mkdir -p "$subpkgdir/usr/include"
	mv "$pkgdir/usr/include"/* "$subpkgdir/usr/include/" 2>/dev/null || true
}

