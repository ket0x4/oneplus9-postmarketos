# Reference: <https://postmarketos.org/deviceinfo>
deviceinfo_format_version="0"
deviceinfo_name="OnePlus 9 Pro"
deviceinfo_manufacturer="OnePlus"
deviceinfo_codename="oneplus-lemonadep"
deviceinfo_year="2021"
deviceinfo_dtb="qcom/sm8350-oneplus-lemonadep"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_keyboard="false"
deviceinfo_external_storage="false"
deviceinfo_screen_width="1440"
deviceinfo_screen_height="3216"
deviceinfo_dev_touchscreen="/dev/input/event2"

# Bootloader related. ABL only accepts boot header v2 with an uncompressed Image
# and the stock DTB blob attached; see docs/HARDWARE.md. scripts/mkboot.sh is the
# reference for both the header version and the cmdline. A pmbootstrap image at
# the default header v3 is rejected, so repack it with scripts/op9-boot-image.sh.
deviceinfo_flash_method="fastboot"
deviceinfo_kernel_cmdline="fw_devlink=permissive deferred_probe_timeout=30 fw_devlink.sync_state=timeout mem_sleep_default=s2idle console=ttyMSM0,115200n8 earlycon"
deviceinfo_generate_bootimg="true"
deviceinfo_bootimg_qcdt="false"
deviceinfo_bootimg_header_version="2"
deviceinfo_flash_pagesize="4096"
deviceinfo_cgpt_kpart=""
