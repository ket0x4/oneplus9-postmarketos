#!/bin/busybox sh
# OP9 bring-up initramfs: USB NCM network + telnet root shell. Never reboots by itself.
/bin/busybox mkdir -p /usr/bin /usr/sbin
/bin/busybox --install -s
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev
mkdir -p /dev/pts; mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config; mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
exec >/dev/kmsg 2>&1
echo "op9-initramfs: started"

# Debug: op9.reboot_after=N on the cmdline warm-reboots after N seconds so the
# ramoops console log survives and can be read from Android afterwards.
RA=$(sed -n 's/.*op9\.reboot_after=\([0-9]*\).*/\1/p' /proc/cmdline); [ -z "$RA" ] && [ -f /etc/reboot_after ] && RA=$(cat /etc/reboot_after)
if [ -n "$RA" ]; then
	( sleep "$RA"; echo "op9-initramfs: reboot_after=$RA reached, warm reboot"
	  ls /sys/class/udc /sys/class/net; cat /proc/interrupts | head -5
	  echo b > /proc/sysrq-trigger ) &
fi

# Wait for the USB device controller. dwc3 can probe well after init runs (the
# PHY drivers are modules on the rootfs on some builds, and on the OnePlus 9 the
# controller comes up late), and nothing retries the gadget if this gives up, so
# wait long enough to be sure rather than a token 3 s. The wait is capped and
# never blocks the rootfs switch for good.
n=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $n -lt "${UDC_WAIT:-20}" ]; do
	[ $n -eq 0 ] && echo "op9-initramfs: waiting for UDC (up to ${UDC_WAIT:-20}s)"
	n=$((n + 1)); sleep 1
done
UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
echo "op9-initramfs: UDC=${UDC:-none} after ${n}s"

# If there is no controller, say why while the console can still be photographed
if [ -z "$UDC" ]; then
	echo "op9-initramfs: --- usb diagnostics ---"
	echo "op9-initramfs: udc dir: $(ls /sys/class/udc 2>&1)"
	echo "op9-initramfs: dwc3: $(ls -d /sys/bus/platform/devices/*dwc3* 2>&1)"
	dmesg | grep -iE "dwc3|phy|udc|usb|gadget" | tail -40
	echo "op9-initramfs: --- end ---"
fi

G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G && cd $G
echo 0x18d1 > idVendor; echo 0xd001 > idProduct
mkdir -p strings/0x409
echo "OnePlus" > strings/0x409/manufacturer
echo "OnePlus 9 mainline bring-up" > strings/0x409/product
echo "op9-$(cat /proc/sys/kernel/random/boot_id | cut -c1-8)" > strings/0x409/serialnumber
mkdir -p functions/ncm.usb0 functions/acm.gs0 configs/c.1/strings/0x409
echo "NCM + serial" > configs/c.1/strings/0x409/configuration
ln -s functions/ncm.usb0 configs/c.1/
ln -s functions/acm.gs0 configs/c.1/
[ -n "$UDC" ] && echo "$UDC" > UDC
cd /

# usb0 only exists once the gadget is bound to a controller
if [ -n "$UDC" ]; then
for i in $(seq 1 10); do ip link show usb0 >/dev/null 2>&1 && break; sleep 1; done
fi
ip addr add 172.16.42.1/24 dev usb0 2>/dev/null; ip link set usb0 up 2>/dev/null
mkdir -p /var/lib/misc
cat > /etc/udhcpd.conf <<EOC
start 172.16.42.2
end 172.16.42.2
interface usb0
max_leases 1
option subnet 255.255.255.0
EOC
touch /var/lib/misc/udhcpd.leases
# Both stay in the foreground so their PIDs are known: they must not outlive
# the initramfs, or the real system inherits a second DHCP server and a
# listening telnetd whose shell can no longer start.
udhcpd -f /etc/udhcpd.conf &
UDHCPD_PID=$!
telnetd -F -l /bin/sh -b 172.16.42.1 &
TELNETD_PID=$!
# Serial shell too, in case networking fails
( while true; do [ -e /dev/ttyGS0 ] && sh </dev/ttyGS0 >/dev/ttyGS0 2>&1; sleep 1; done ) &
SERIAL_PID=$!
echo "op9-initramfs: USB ready (serial on ttyGS0, NCM 172.16.42.1)"

# Root filesystem: ext4 on the old Android userdata partition, falling back to
# the "linux" logical partition in super (dm-linear) if that fails.
# op9.root=super forces the fallback.
find_part() {
	PART=""; n=0
	while [ -z "$PART" ] && [ $n -lt 30 ]; do
		for d in /sys/class/block/*; do
			grep -qx "PARTNAME=$1" "$d/uevent" 2>/dev/null && PART=$(cat "$d/dev")
		done
		[ -z "$PART" ] && { n=$((n + 1)); sleep 1; }
	done
	# stdout is captured by the caller; stderr is the kernel log
	[ -n "$PART" ] || { echo "op9-initramfs: $1 not found" >&2; return 1; }
	mkdir -p /dev/op9; rm -f "/dev/op9/$1"
	mknod "/dev/op9/$1" b "${PART%:*}" "${PART#*:}"
	echo "/dev/op9/$1"
}

try_root() {
	mkdir -p /sysroot
	# ext4 is what docs/INSTALL.md builds; f2fs and squashfs are here because the
	# kernel config enables them and postmarketOS images can use either.
	mounted=""
	for t in ext4 f2fs squashfs; do
		# squashfs is read-only by nature; the others must be writable to switch_root
		opts=rw; [ "$t" = squashfs ] && opts=ro
		if mount -t "$t" -o "$opts" "$1" /sysroot; then mounted=$t; break; fi
	done
	[ -n "$mounted" ] || { echo "op9-initramfs: mount $1 failed" >&2; return 1; }
	if [ -e /sysroot/sbin/init ] || [ -L /sysroot/sbin/init ]; then
		echo "op9-initramfs: switching to rootfs on $1"
		if [ ! -s /sysroot/etc/machine-id ] || grep -q uninitialized /sysroot/etc/machine-id 2>/dev/null; then
			tr -d '-' < /proc/sys/kernel/random/uuid > /sysroot/etc/machine-id
		fi
		[ -s /sysroot/etc/locale.conf ] || echo "LANG=C.UTF-8" > /sysroot/etc/locale.conf
		[ -e /sysroot/etc/localtime ] || ln -sf /usr/share/zoneinfo/UTC /sysroot/etc/localtime
		# One-time rootfs fixups. The chown below walks /usr, so it must not run on
		# every boot; the marker is written last, once the pass has completed.
		if [ ! -e /sysroot/etc/op9-rootfs-initialised ]; then
			echo "op9-initramfs: first boot on $1, fixing ownership and firstboot"
			rm -f /sysroot/usr/lib/systemd/system/sysinit.target.wants/systemd-firstboot.service \
			      /sysroot/etc/systemd/system/sysinit.target.wants/systemd-firstboot.service \
			      /sysroot/usr/lib/systemd/system/systemd-firstboot.service
			chown 0:0 /sysroot /sysroot/etc /sysroot/usr /sysroot/var /sysroot/root 2>/dev/null
			find /sysroot/etc /sysroot/usr /sysroot/root -user 1000 -exec chown 0:0 {} + 2>/dev/null
			echo "by op9-initramfs" > /sysroot/etc/op9-rootfs-initialised
		fi
		# /sbin/init must be systemd. Installing busybox or a plain `apk upgrade` can
		# put its own /sbin/init -> /bin/busybox symlink back, and then the kernel runs
		# busybox init, which reads /etc/inittab and hands over to OpenRC - not
		# installed here - so it panics on the first getty and the phone reboot-loops
		# with "can't open /dev/tty1..6". The rootfs is mounted rw right here, before
		# switch_root, so repair it every boot; this is cheap and idempotent.
		if [ -L /sysroot/sbin/init ]; then
			target=$(readlink /sysroot/sbin/init)
			case "$target" in
			*busybox*)
				echo "op9-initramfs: /sbin/init pointed at $target, restoring systemd"
				if [ -e /sysroot/usr/sbin/init ]; then
					ln -sfn /usr/sbin/init /sysroot/sbin/init
				elif [ -e /sysroot/usr/lib/systemd/systemd ]; then
					ln -sfn /usr/lib/systemd/systemd /sysroot/sbin/init
				else
					echo "op9-initramfs: no systemd to point /sbin/init at" >&2
				fi
				;;
			esac
		fi
		kill "$SERIAL_PID" "$TELNETD_PID" "$UDHCPD_PID" 2>/dev/null
		umount /sys/kernel/debug /sys/kernel/config /dev/pts 2>/dev/null
		exec switch_root /sysroot /sbin/init
	fi
	echo "op9-initramfs: no /sbin/init on $1"; umount /sysroot; return 1
}

switch_to_rootfs() {
	grep -q 'op9.noswitch' /proc/cmdline && { echo "op9-initramfs: op9.noswitch, staying"; return; }
	if ! grep -q 'op9.root=super' /proc/cmdline; then
		DEV=$(find_part userdata) && try_root "$DEV"
	fi
	find_part super >/dev/null || return
	SUPER=$PART
	DM=$(grep -v '^#' /etc/op9-linux.extents | while read s l o; do echo "$s $l linear $SUPER $o"; done | dmcreate linux) ||
		{ echo "op9-initramfs: dmcreate failed" >&2; return; }
	echo "op9-initramfs: linux -> $DM (super $SUPER)"
	try_root "$DM"
}
switch_to_rootfs
dmesg > /tmp/dmesg-boot.txt
while true; do sleep 3600; done
