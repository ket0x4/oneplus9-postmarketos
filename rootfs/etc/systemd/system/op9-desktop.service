# Desktop mode: GNOME on the external display. Starting it stops Phosh (and its apps);
# when it ends, for any reason, Phosh starts again.
[Unit]
Description=GNOME desktop mode
After=systemd-user-sessions.service
Wants=dbus.socket systemd-logind.service op9-desktop-input.service
# postmarketOS edge runs Phosh under greetd/phrog, not a phosh.service; conflict with
# whichever of them owns the seat so only one compositor is on the screens.
Conflicts=getty@tty7.service phosh.service greetd.service
After=getty@tty7.service phosh.service

[Service]
Type=simple
ExecStartPre=+/usr/bin/chvt 7
ExecStartPre=+/usr/local/bin/op9-kms-reset
# See op9-desktop.conf for Phosh: keep the kernel console off the screens while switching.
ExecStop=+/usr/local/bin/op9-kms-reset --console-off
ExecStart=/usr/local/bin/op9-desktop-session
# phosh.service on images that have one, greetd (and its greeter) on ones that don't. The
# helper waits for gnome-shell to release tty7; starting the display manager too early
# leaves its session worker unable to take the VT and both screens stay black.
ExecStopPost=+/usr/local/bin/op9-desktop-restore
# That helper waits up to 30 s for the two things above to settle, so the manager's
# DefaultTimeoutStopSec (5 s on the fast-shutdown images this port documents) would kill it
# mid-wait: op9-desktop.service then fails with result 'timeout' and nothing starts Phosh,
# leaving both screens black until a reboot.
TimeoutStopSec=90s
User=1000
WorkingDirectory=~
PAMName=login
Environment=XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=GNOME XDG_SESSION_DESKTOP=gnome
TTYPath=/dev/tty7
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty7
UtmpMode=user
