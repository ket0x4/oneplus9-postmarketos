// The phone's user switches between Phosh and desktop mode without a password. Only this
// unit is allowed, and each direction cleans up after itself: starting it replaces Phosh,
// stopping it restores Phosh through its ExecStopPost, which runs as root and so needs no
// rule for phosh.service/greetd.service.
polkit.addRule(function(action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
	    action.lookup("unit") == "op9-desktop.service" &&
	    (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
	    ((subject.local && subject.active) || subject.isInGroup("wheel")))
		return polkit.Result.YES;
});
